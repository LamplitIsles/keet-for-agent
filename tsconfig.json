{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@lamplitisles/keet-integration-core": ["./packages/keet-core/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages", "tests", "scripts", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["**/dist"]
}
