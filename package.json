{
  "name": "keet-for-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware packages tests scripts tsdown.config.ts vitest.config.ts",
    "test": "vitest run tests",
    "build": "pnpm --filter @lamplitisles/dsh-keet build && pnpm --filter @lamplitisles/impri-keet build",
    "deploy": "pnpm build && systemctl --user restart dsh.service",
    "pack-smoke": "tsx scripts/pack-smoke.ts",
    "real-worker-smoke": "tsx packages/keet-core/test/real-worker-smoke.ts",
    "official-onboarding-smoke": "pnpm build && tsx scripts/official-onboarding-smoke.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.15.0",
    "@types/react": "18.3.18",
    "@types/react-test-renderer": "18.0.7",
    "lightningcss": "^1.33.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsdown": "0.23.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "tiny-buffer-rpc": "2.4.0"
  }
}
