{
  "name": "keet-for-agent-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware packages tests scripts tsdown.config.ts vitest.config.ts",
    "test": "vitest run tests",
    "build": "pnpm --filter @lamplitisles/impri-keet build && tsdown --config tsdown.config.ts",
    "pack-smoke": "tsx scripts/mcp-pack-smoke.ts",
    "real-worker-smoke": "tsx packages/keet-core/test/real-worker-smoke.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.15.0",
    "@types/ws": "8.18.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.33.5",
    "tsdown": "0.23.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "ws": "8.18.3"
  },
  "dependencies": {
    "tiny-buffer-rpc": "2.4.0"
  }
}
